        <PackageVersion Include="NSubstitute" Version="5.3.0"/>
        <PackageVersion Include="NSwag.AspNetCore" Version="14.3.0"/>
        <PackageVersion Include="NeoLua" Version="1.3.14"/>

        <PackageVersion Include="NuGet.Common" Version="6.13.2"/>
        <PackageVersion Include="NuGet.Configuration" Version="6.13.2"/>
        <PackageVersion Include="NuGet.Frameworks" Version="6.13.2"/>
        <PackageVersion Include="NuGet.Packaging.Core" Version="6.9.1"/>
        <PackageVersion Include="NuGet.Protocol" Version="6.13.2"/>
        <PackageVersion Include="NuGet.Resolver" Version="6.13.2"/>
        <PackageVersion Include="NuGet.Versioning" Version="6.13.2"/>

        <PackageVersion Include="Serilog" Version="4.2.0"/>
        <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1"/>
        <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0"/>
