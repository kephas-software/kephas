        <PackageVersion Include="Basic.Reference.Assemblies.Net90" Version="1.8.0"/>
        <PackageVersion Include="MySql.EntityFrameworkCore" Version="9.0.0"/>
        <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0"/>
